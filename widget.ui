  <property name="styleSheet">
   <string notr="true">QTextEdit{		
	
	background-color: rgb(130, 162, 172);
	border:1px solid rgb(173, 216, 230);
	color: back;
}
/****************************************************************/
QScrollBar:vertical{
	border:2px solid rgb(173, 216, 230);
	background:lightblue;
	width: 20px;
	padding-top:20px;
	padding-bottom:20px;
}
QScrollBar::handle:vertical{
	width:8px;
	background:rgb(170, 211, 225);
	min-height:30px;
	margin: 1px 0px 1px 1px;
}
QScrollBar::add-line:vertical   
{
    height:20px;width:18px;
    subcontrol-position:bottom;
	background:rgb(173, 216, 230);
	border: 1px solid rgb(155, 155, 155);
	
	image: url(:/image/arrow_down.png);
}
QScrollBar::sub-line:vertical   
{
    height:20px;width:18px;
    subcontrol-position:top;
	background:rgb(173, 216, 230);
	border: 1px solid rgb(155, 155, 155);
	
	image: url(:/image/arrow_up.png);
}
/**************************QPushButton*************************/
QPushButton{
	background-color:lightblue;
	border:1px solid rgb(119, 149, 158);
	border-radius:0px;
	font:15px bold Khmer UI
}
QPushButton:hover{
	/*border:1px solid blue;*/
	background:rgb(170, 211, 225);
}
QPushButton:pressed{
	background: rgb(125, 155, 165);
}
/**************************组合框***********************/
QComboBox{
	background-color: lightblue;
	border: 1px solid rgb(119, 149, 158);
	border-radius: 0px;
	padding:1px 2px 1px 2px;
	font:15px bold Khmer UI
}
QComboBox:hover {
	background:rgb(170, 211, 225);
}
QComboBox::dowm-arrow{
	
}
QComboBox::drop-down{
	subcontrol-origin:padding;
	subcontrol-position: top right;
	width:13px;
	
	border-left-width:2px;
	border-left-color:rgb(119, 149, 158);
	border-left-style:solid;

	image: url(:/image/arrow_down.png);
}
/******************************QTabWidget************************/
QTabWidget::pane{
	border: 2px solid lightblue;
}
QTabWidget::tab-bar{
	left: 50px;
}
QTabBar::tab{
    background:lightblue;
    border: 1px solid rgb(119, 149, 158);
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    min-width: 30ex;
    padding: 2px;	
}
QTabBar::tab:selected, QTabBar::tab:hover {
	background:rgb(170, 211, 225);
}

QTabBar::tab:selected {
    border-color: #9B9B9B;
    border-bottom-color: lightblue; /* same as pane color */
}

QTabBar::tab:!selected {
    margin-top: 2px; /* make non-selected tabs look smaller */
}
QTabBar::tab:selected {
    /* expand/overlap to the left and right by 4px */
    margin-left: -1px;
    margin-right: -1px;
}
QTabBar::tab:first:selected {
    margin-left: 0; /* the first selected tab has nothing to overlap with on the left */
}

QTabBar::tab:last:selected {
    margin-right: 0; /* the last selected tab has nothing to overlap with on the right */
}

QTabBar::tab:only-one {
    margin: 0; /* if there is only one tab, we don't want overlapping margins */
}
/****************************Progress Bar***************************/
QProgressBar{
	border:2px solid rgb(119, 149, 158);
	text-align:center;
}
QProgressBar::chunk{
	background-color:rgb(173, 216, 230);
	width:20px;
	margin:0.5px;
}</string>
